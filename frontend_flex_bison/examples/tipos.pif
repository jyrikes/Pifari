@ Anotações de tipo verificadas (docs/SPEC_SEMANTICA.md §2–§5, etapa F1).
@ Tipos desconhecidos e valores incompatíveis falham com linha e coluna.

idade =: int(20)
altura =: float(1.75)
nome =: str("Ana")
aprovado =: bool(true)
promovido =: float(3)

print(idade, altura, nome, aprovado, promovido)

dobro =: float(idade * 2)
print("promocao int -> float:", dobro)

depois =: int
print("sem inicializador:", depois)

contador =: int(0)
contador = contador + 1
print("atribuicao posterior:", contador)

@ Funções com parâmetros e retorno tipados (F1b)
function soma(a: int, b: int) -> int
  return a + b

function metade(x: float) -> float
  return x / 2

function total() -> float
  return 3

print("soma tipada:", soma(2, 3))
print("parametro promovido:", metade(5))
print("retorno promovido:", total())
